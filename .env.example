# Application
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database
MYSQL_DATABASE=reservation_chatbot
