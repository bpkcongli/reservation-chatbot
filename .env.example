# Application
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Jakarta
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database — preferred local/on-machine MySQL.
# Docker Compose MySQL exposed to the host uses the same 127.0.0.1 URL.
# If the backend itself runs in Docker, change the host to the service name `mysql`.
MYSQL_DATABASE=reservation_chatbot
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/reservation_chatbot
MODEL_PATH=artifacts/models/intent-classifier.joblib
CONVERSATION_LOG_DIR=data/logs
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

# Browser-exposed frontend configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
