{
  "name": "reservation-chatbot",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "lint-staged": {
    "apps/backend/**/*.py": [
      "apps/backend/.venv/bin/ruff check --fix",
      "apps/backend/.venv/bin/ruff format"
    ],
    "apps/frontend/**/*.{js,jsx,ts,tsx}": [
      "bun run --cwd apps/frontend lint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  }
}
